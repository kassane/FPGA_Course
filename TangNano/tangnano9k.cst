# TangNano 9K (GW1NR-9C, QN88P package)
# IMPORTANT: Verify pin numbers against Sipeed TangNano 9K schematic before programming:
# https://wiki.sipeed.com/hardware/en/tang/Tang-Nano-9K/Nano-9K.html
IO_LOC "SYS_CLK"  52;
IO_LOC "SYS_RSTn"  4;
IO_LOC "LED_R"    10;
IO_LOC "LED_G"    11;
IO_LOC "LED_B"    13;
IO_PORT "SYS_CLK"  IO_TYPE=LVCMOS33;
IO_PORT "SYS_RSTn" IO_TYPE=LVCMOS33;
IO_PORT "LED_R"    IO_TYPE=LVCMOS33;
IO_PORT "LED_G"    IO_TYPE=LVCMOS33;
IO_PORT "LED_B"    IO_TYPE=LVCMOS33;
IO_LOC "LED3"     14;
IO_LOC "LED4"     15;
IO_LOC "LED5"     16;
IO_LOC "BTN_S1"    3;
IO_LOC "UART_TX"  17;
IO_LOC "UART_RX"  18;
IO_PORT "LED3"     IO_TYPE=LVCMOS33;
IO_PORT "LED4"     IO_TYPE=LVCMOS33;
IO_PORT "LED5"     IO_TYPE=LVCMOS33;
IO_PORT "BTN_S1"   IO_TYPE=LVCMOS33;
IO_PORT "UART_TX"  IO_TYPE=LVCMOS33;
IO_PORT "UART_RX"  IO_TYPE=LVCMOS33;
